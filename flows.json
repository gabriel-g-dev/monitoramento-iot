    {
        "id": "fn_alerta",
        "type": "function",
        "z": "tab_main",
        "name": "Verificar Alertas",
        "func": "var temp = msg.payload;\nvar alerta;\nif (temp >= 40) {\n    alerta = \"CRITICO: Temperatura muito alta! \" + temp + \" C\";\n} else if (temp >= 35) {\n    alerta = \"ALERTA: Temperatura alta! \" + temp + \" C\";\n} else if (temp >= 30) {\n    alerta = \"ATENCAO: Temperatura elevada \" + temp + \" C\";\n} else {\n    alerta = \"OK: Sistema normal - \" + temp + \" C\";\n}\nmsg.payload = alerta;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 660,
        "y": 180,
        "wires": [["text_alerta"]]
    },
