        "type": "function",
        "z": "tab_main",
        "name": "Preparar SQL Temperatura",
        "func": "msg.topic = \"INSERT INTO leituras (sensor, valor, unidade) VALUES (?, ?, ?)\";\nmsg.payload = [\"temperatura\", msg.payload, \"C\"];\nreturn msg;",
