    {
        "id": "fn_clima_url",
        "type": "function",
        "z": "tab_main",
        "name": "Montar URL OpenWeather",
        "func": "var apiKey = \"SUA_API_KEY_AQUI\";\nvar cidade = \"Sao Paulo,BR\";\nmsg.url = \"https://api.openweathermap.org/data/2.5/weather?q=\" + encodeURIComponent(cidade) + \"&appid=\" + apiKey + \"&units=metric&lang=pt_br\";\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 580,
        "wires": [["http_clima"]]
    },
    {
        "id": "http_clima",
        "type": "http request",
        "z": "tab_main",
        "name": "OpenWeather API",
        "method": "GET",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "",
        "persist": false,
        "insecureHTTPParser": false,
        "authType": "",
        "senderr": false,
        "headers": [],
        "x": 610,
        "y": 580,
        "wires": [["fn_parse_clima"]]
    },
    {
        "id": "fn_parse_clima",
        "type": "function",
        "z": "tab_main",
        "name": "Processar Resposta Clima",
        "func": "var d = msg.payload;\nif (!d || !d.main) {\n    node.warn('Resposta inválida da API: ' + JSON.stringify(d));\n    return null;\n}\nvar cidade   = { payload: d.name + ', ' + d.sys.country };\nvar temp     = { payload: d.main.temp.toFixed(1) + ' C' };\nvar sensacao = { payload: d.main.feels_like.toFixed(1) + ' C' };\nvar umidade  = { payload: d.main.humidity + ' %' };\nvar descr    = { payload: d.weather[0].description };\nvar vento    = { payload: d.wind.speed.toFixed(1) + ' m/s' };\nreturn [cidade, temp, sensacao, umidade, descr, vento];",
        "outputs": 6,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 830,
        "y": 580,
        "wires": [
            ["text_c_cidade"],
            ["text_c_temp"],
            ["text_c_sensacao"],
            ["text_c_umid"],
            ["text_c_desc"],
            ["text_c_vento"]
        ]
    },
